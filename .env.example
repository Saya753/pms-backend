# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/project-management?schema=public

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
SKIP_DB=false

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=6d
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE_ACCESS=http://localhost:3001/admin
JWT_AUDIENCE_REFRESH=http://localhost:3001/token

# Security and business settings
BCRYPT_COST=12
VAT_RATE=0.1
# Email verification
EMAIL_VERIFICATION_SECRET=replace-with-a-long-random-secret
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# SMTP (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Kimia Yadak <no-reply@example.com>"
